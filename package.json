{
  "name": "universal-code-cleaner",
  "displayName": "Universal Code Cleaner",
  "description": "Remove comments and clean unused code safely from an entire workspace.",
  "version": "1.0.0",
  "publisher": "dimartarmizi",
  "author": "Dimar Tarmizi",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCleaner.removeComments",
        "title": "Clean Code: Remove Comments"
      },
      {
        "command": "codeCleaner.removeDeadCode",
        "title": "Clean Code: Remove Dead Code"
      },
      {
        "command": "codeCleaner.removeEmptyLines",
        "title": "Clean Code: Remove Empty Lines"
      },
      {
        "command": "codeCleaner.removeTrailingSpaces",
        "title": "Clean Code: Remove Trailing Spaces"
      },
      {
        "command": "codeCleaner.removeConsoleLogs",
        "title": "Clean Code: Remove Console Logs"
      },
      {
        "command": "codeCleaner.sortImports",
        "title": "Clean Code: Sort Imports"
      },
      {
        "command": "codeCleaner.removeEmptyFiles",
        "title": "Clean Code: Remove Empty Files"
      },
      {
        "command": "codeCleaner.removeEmptyFolders",
        "title": "Clean Code: Remove Empty Folders"
      },
      {
        "command": "codeCleaner.convertIndent",
        "title": "Clean Code: Convert Indentation"
      },
      {
        "command": "codeCleaner.toggleFileItem",
        "icon": "$(check)",
        "title": "Toggle Selection"
      },
      {
        "command": "codeCleaner.applySelectedClean",
        "icon": "$(check-all)",
        "enablement": "codeCleaner.hasResults",
        "title": "Apply Selected Changes"
      },
      {
        "command": "codeCleaner.clearResults",
        "icon": "$(clear-all)",
        "enablement": "codeCleaner.hasResults",
        "title": "Clear Results"
      },
      {
        "command": "codeCleaner.refreshResults",
        "icon": "$(refresh)",
        "enablement": "codeCleaner.hasResults",
        "title": "Refresh Scan"
      },
      {
        "command": "codeCleaner.collapseAllResults",
        "icon": "$(collapse-all)",
        "enablement": "codeCleaner.hasResults",
        "title": "Collapse All"
      },
      {
        "command": "codeCleaner.expandAllResults",
        "icon": "$(expand-all)",
        "enablement": "codeCleaner.hasResults",
        "title": "Expand All"
      },
      {
        "command": "codeCleaner.runActionFromSidebar",
        "icon": "$(play-circle)",
        "title": "Run Clean Code Action"
      },
      {
        "command": "codeCleaner.toggleViewMode",
        "icon": "$(list-tree)",
        "enablement": "codeCleaner.hasResults",
        "title": "Show as List"
      },
      {
        "command": "codeCleaner.toggleViewModeTree",
        "icon": "$(list-flat)",
        "enablement": "codeCleaner.hasResults",
        "title": "Show as Tree"
      },
      {
        "command": "codeCleaner.applySingleLineItem",
        "icon": "$(check)",
        "title": "Apply Line Change"
      },
      {
        "command": "codeCleaner.applySingleFileItem",
        "icon": "$(check-all)",
        "title": "Apply File Changes"
      },
      {
        "command": "codeCleaner.dismissLineItem",
        "icon": "$(x)",
        "title": "Dismiss Line Change"
      },
      {
        "command": "codeCleaner.dismissFileItem",
        "icon": "$(x)",
        "title": "Dismiss File Changes"
      },
      {
        "command": "codeCleaner.dismissFolderItem",
        "icon": "$(x)",
        "title": "Dismiss Folder"
      },
      {
        "command": "codeCleaner.applySingleFolderItem",
        "icon": "$(check-all)",
        "title": "Apply Folder Changes"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "code-cleaner-view-container",
          "title": "Code Cleaner",
          "icon": "$(rocket)"
        }
      ]
    },
    "views": {
      "code-cleaner-view-container": [
        {
          "id": "codeCleanerSidebar",
          "name": "Code Cleaner",
          "type": "tree",
          "icon": "$(rocket)"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "codeCleaner.applySingleFolderItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerFolderItem",
          "group": "inline"
        },
        {
          "command": "codeCleaner.dismissFolderItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerFolderItem",
          "group": "inline"
        },
        {
          "command": "codeCleaner.applySingleFileItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerFileItem",
          "group": "inline"
        },
        {
          "command": "codeCleaner.dismissFileItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerFileItem",
          "group": "inline"
        },
        {
          "command": "codeCleaner.applySingleLineItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerLineItem",
          "group": "inline"
        },
        {
          "command": "codeCleaner.dismissLineItem",
          "when": "view == codeCleanerSidebar && viewItem == cleanerLineItem",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "codeCleaner.runActionFromSidebar",
          "when": "view == codeCleanerSidebar",
          "group": "navigation@1"
        },
        {
          "command": "codeCleaner.applySelectedClean",
          "when": "view == codeCleanerSidebar",
          "group": "navigation@2"
        },
        {
          "command": "codeCleaner.refreshResults",
          "when": "view == codeCleanerSidebar",
          "group": "navigation@3"
        },
        {
          "command": "codeCleaner.toggleViewMode",
          "when": "view == codeCleanerSidebar && !codeCleaner.isListView",
          "group": "navigation@4"
        },
        {
          "command": "codeCleaner.toggleViewModeTree",
          "when": "view == codeCleanerSidebar && codeCleaner.isListView",
          "group": "navigation@4"
        },
        {
          "command": "codeCleaner.collapseAllResults",
          "when": "view == codeCleanerSidebar && !codeCleaner.isCollapsed",
          "group": "navigation@5"
        },
        {
          "command": "codeCleaner.expandAllResults",
          "when": "view == codeCleanerSidebar && codeCleaner.isCollapsed",
          "group": "navigation@5"
        },
        {
          "command": "codeCleaner.clearResults",
          "when": "view == codeCleanerSidebar",
          "group": "navigation@6"
        }
      ]
    },
    "configuration": {
      "title": "Universal Code Cleaner",
      "properties": {
        "codeCleaner.ignore": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/vendor/**",
            "**/build/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to ignore.",
          "items": {
            "type": "string"
          }
        },
        "codeCleaner.keep": {
          "type": "array",
          "default": [
            "license",
            "ts-ignore",
            "eslint-disable",
            "prettier-ignore"
          ],
          "description": "Keywords in comments to preserve (case-insensitive).",
          "items": {
            "type": "string"
          }
        },
        "codeCleaner.preview": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation/preview dialog before cleaning."
        },
        "codeCleaner.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save modified files."
        },
        "codeCleaner.consoleLogs.keepError": {
          "type": "boolean",
          "default": true,
          "description": "Preserve console.error statements when cleaning console logs."
        },
        "codeCleaner.consoleLogs.keepWarn": {
          "type": "boolean",
          "default": false,
          "description": "Preserve console.warn statements when cleaning console logs."
        },
        "codeCleaner.emptyLines.maxConsecutive": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "Maximum consecutive empty lines allowed in document."
        },
        "codeCleaner.indent.style": {
          "default": "tab",
          "description": "Target indentation style (tab or space).",
          "enum": ["tab", "space"],
          "type": "string"
        },
        "codeCleaner.indent.size": {
          "default": 4,
          "description": "Number of spaces equivalent to one tab for conversion.",
          "minimum": 1,
          "type": "integer"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "fast-glob": "^3.3.1"
  }
}
