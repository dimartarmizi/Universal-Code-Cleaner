{
  "name": "universal-code-cleaner",
  "displayName": "Universal Code Cleaner",
  "description": "Remove comments and clean unused code safely from an entire workspace.",
  "version": "1.0.0",
  "publisher": "dimartarmizi",
  "author": "Dimar Tarmizi",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeCleaner.removeCommentsCurrentFile",
        "title": "Clean Code: Remove Comments from Current File"
      },
      {
        "command": "codeCleaner.removeCommentsWorkspace",
        "title": "Clean Code: Remove Comments from Workspace"
      },
      {
        "command": "codeCleaner.removeDeadCodeCurrentFile",
        "title": "Clean Code: Remove Dead Code from Current File"
      },
      {
        "command": "codeCleaner.removeDeadCodeWorkspace",
        "title": "Clean Code: Remove Dead Code from Workspace"
      },
      {
        "command": "codeCleaner.removeEmptyLinesCurrentFile",
        "title": "Clean Code: Remove Empty Lines from Current File"
      },
      {
        "command": "codeCleaner.removeEmptyLinesWorkspace",
        "title": "Clean Code: Remove Empty Lines from Workspace"
      },
      {
        "command": "codeCleaner.removeTrailingSpacesCurrentFile",
        "title": "Clean Code: Remove Trailing Spaces from Current File"
      },
      {
        "command": "codeCleaner.removeTrailingSpacesWorkspace",
        "title": "Clean Code: Remove Trailing Spaces from Workspace"
      },
      {
        "command": "codeCleaner.removeConsoleLogsCurrentFile",
        "title": "Clean Code: Remove Console Logs from Current File"
      },
      {
        "command": "codeCleaner.removeConsoleLogsWorkspace",
        "title": "Clean Code: Remove Console Logs from Workspace"
      },
      {
        "command": "codeCleaner.sortImportsCurrentFile",
        "title": "Clean Code: Sort Imports in Current File"
      },
      {
        "command": "codeCleaner.sortImportsWorkspace",
        "title": "Clean Code: Sort Imports in Workspace"
      },
      {
        "command": "codeCleaner.removeEmptyFilesWorkspace",
        "title": "Clean Code: Remove Empty Files from Workspace"
      },
      {
        "command": "codeCleaner.removeEmptyFoldersWorkspace",
        "title": "Clean Code: Remove Empty Folders from Workspace"
      }
    ],
    "configuration": {
      "title": "Universal Code Cleaner",
      "properties": {
        "codeCleaner.ignore": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/vendor/**",
            "**/build/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to ignore.",
          "items": {
            "type": "string"
          }
        },
        "codeCleaner.keep": {
          "type": "array",
          "default": [
            "license",
            "ts-ignore",
            "eslint-disable",
            "prettier-ignore"
          ],
          "description": "Keywords in comments to preserve (case-insensitive).",
          "items": {
            "type": "string"
          }
        },
        "codeCleaner.preview": {
          "type": "boolean",
          "default": true,
          "description": "Show confirmation/preview dialog before cleaning."
        },
        "codeCleaner.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save modified files."
        },
        "codeCleaner.consoleLogs.keepError": {
          "type": "boolean",
          "default": true,
          "description": "Preserve console.error statements when cleaning console logs."
        },
        "codeCleaner.consoleLogs.keepWarn": {
          "type": "boolean",
          "default": false,
          "description": "Preserve console.warn statements when cleaning console logs."
        },
        "codeCleaner.emptyLines.maxConsecutive": {
          "type": "integer",
          "default": 1,
          "minimum": 0,
          "description": "Maximum consecutive empty lines allowed in document."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "fast-glob": "^3.3.1"
  }
}
